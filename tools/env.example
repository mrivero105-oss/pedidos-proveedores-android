# Copia este archivo como tools/.env (ignorado por Git) para activar la
# sincronización automática PC -> Supabase (--push-rest / Tarea Programada).
# NUNCA compartas ni subas tools/.env a GitHub ni pongas service_role en el teléfono.

# --- Destino: Supabase ---
SUPABASE_URL=https://puvqiipussyktfmgafgv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PEGA_AQUI_TU_SERVICE_ROLE_KEY_SOLO_EN_TU_PC

# --- Fuente principal (recomendado): PostgreSQL 16 local de Isaac POS en SOLO LECTURA ---
# Si se dejan vacíos o Postgres no responde, el script usa automáticamente el
# respaldo más reciente de ISAAC_POS_BACKUP_DIR como fallback.
LOCAL_PG_HOST=127.0.0.1
LOCAL_PG_PORT=5432
LOCAL_PG_DB=
LOCAL_PG_USER=postgres
LOCAL_PG_PASSWORD=
LOCAL_PG_PSQL=C:\Program Files\PostgreSQL\16\bin\psql.exe

# --- Fallback automático: carpeta de respaldos de Isaac POS ---
ISAAC_POS_BACKUP_DIR=C:\IsaacPOS_Respaldos
ISAAC_POS_COMPANY_ID=2
